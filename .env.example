# Model provider key. Headroom uses Google Gemini through Mozaik (@mozaik-ai/core 6.0.0) by default:
# get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, only for the models below: Groq (HEADROOM_MODEL_*=groq/<model>), Anthropic or OpenAI.
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
PORT=4317
UPLOAD_MAX_MB=10
# Model requests per minute across all agents. The default (10 for Gemini) keeps the free tier from
# rejecting bursts; raise it on a paid tier, 0 turns pacing off.
HEADROOM_MAX_RPM=
# Optional model overrides (must be in the Mozaik 6.0.0 supported model list), for example
# gemini-3.5-flash (the default is gemini-3.5-flash-lite), gemini-3.1-pro-preview, claude-sonnet-5-5 (needs ANTHROPIC_API_KEY),
# gpt-5.4-mini (needs OPENAI_API_KEY)
HEADROOM_MODEL_READER=
HEADROOM_MODEL_VERIFIER=
