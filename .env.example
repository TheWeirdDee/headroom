# Model provider key. Headroom uses Google Gemini through Mozaik (@mozaik-ai/core 6.0.0) by default:
# get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, only for Groq models (HEADROOM_MODEL_*=groq/<model>).
# GROQ_API_KEY=
PORT=4317
UPLOAD_MAX_MB=10
# Model requests per minute across all agents. The default (14 for Gemini) keeps the free tier from
# rejecting bursts; raise it on a paid tier, 0 turns pacing off.
HEADROOM_MAX_RPM=
# Optional model overrides (must be in the Mozaik 6.0.0 supported model list), for example
# gemini-3.5-flash (the default is gemini-3.5-flash-lite) or groq/openai/gpt-oss-120b.
HEADROOM_MODEL_READER=
HEADROOM_MODEL_VERIFIER=
# Backup models, used when a daily quota runs out during a check (comma separated; "none" turns this off).
# Unset on Gemini: gemini-3.1-flash-lite, on the same free key. Naming a Groq model here also sends document
# text to Groq.
HEADROOM_MODEL_BACKUP=
